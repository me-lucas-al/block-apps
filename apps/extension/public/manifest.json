{
  "manifest_version": 3,
  "name": "Block Apps",
  "version": "0.1.0",
  "description": "Bloqueia sites sempre ou fora de horarios permitidos.",
  "minimum_chrome_version": "110",
  "action": { "default_popup": "popup.html", "default_title": "Block Apps" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}
