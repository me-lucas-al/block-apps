{
  "name": "@block-apps/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "pnpm sync:ios-shared && expo run:ios",
    "prebuild:ios": "pnpm sync:ios-shared && expo prebuild --platform ios --clean",
    "sync:ios-shared": "node scripts/syncIosSharedSources.mjs",
    "eas-build-pre-install": "node scripts/syncIosSharedSources.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@block-apps/api": "workspace:*",
    "@block-apps/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.24",
    "expo-auth-session": "^58.0.18",
    "expo-background-task": "58.0.12",
    "expo-secure-store": "^58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "58.0.13",
    "expo-web-browser": "^58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react-dom": "19.3.0"
  }
}
